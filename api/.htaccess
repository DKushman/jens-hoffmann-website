# Keine Verzeichnisliste
Options -Indexes

# Dateien mit "_" am Anfang (z. B. _config.php mit den SMTP-Zugangsdaten) nie ausliefern
<FilesMatch "^_">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
